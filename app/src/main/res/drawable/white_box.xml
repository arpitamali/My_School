<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- White background -->
    <solid android:color="#FFFFFF"/>

    <!-- Light border -->
    <stroke
        android:width="1dp"
        android:color="#E2E2E2"/>

    <!-- Rounded corners -->
    <corners
        android:radius="10dp"/>

    <!-- Inner spacing -->
    <padding
        android:left="15dp"
        android:right="15dp"
        android:top="15dp"
        android:bottom="15dp"/>

</shape>