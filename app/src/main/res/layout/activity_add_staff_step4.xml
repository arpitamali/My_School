<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="30dp">


        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Add Staff / Teacher"
                android:textColor="#4B1FA8"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="45dp"
                android:layout_height="45dp"/>

        </LinearLayout>


        <!-- ================= STEP INDICATOR ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="1"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="2"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="3"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_active"
                android:gravity="center"
                android:text="4"
                android:textColor="@android:color/white"
                android:textStyle="bold"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#DDDDDD"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="5"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#DDDDDD"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="6"
                android:textColor="#777777"/>

        </LinearLayout>


        <!-- ================= TITLE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Address &amp; Emergency Contact"
            android:textColor="#17102D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Enter address and emergency contact details"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>


        <!-- ================= CURRENT ADDRESS ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Address"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etCurrentAddress"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Enter current address"
            android:layout_marginTop="7dp"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= PERMANENT ADDRESS ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permanent Address"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etPermanentAddress"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:hint="Enter permanent address"
            android:layout_marginTop="7dp"
            android:gravity="top|start"
            android:inputType="textCapSentences|textMultiLine"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= CITY ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="City / Village"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter city / village"
            android:layout_marginTop="7dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= DISTRICT ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="District"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etDistrict"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter district"
            android:layout_marginTop="7dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= STATE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="State"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etState"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter state"
            android:layout_marginTop="7dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= PIN ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PIN Code"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etPinCode"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter 6 digit PIN code"
            android:layout_marginTop="7dp"
            android:inputType="number"
            android:maxLength="6"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= EMERGENCY ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emergency Contact"
            android:textColor="#4B1FA8"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="5dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emergency Contact Name *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="10dp"/>

        <EditText
            android:id="@+id/etEmergencyName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter emergency contact name"
            android:layout_marginTop="7dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relation *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etEmergencyRelation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Example: Father, Mother, Spouse"
            android:layout_marginTop="7dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emergency Mobile *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etEmergencyMobile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter 10 digit mobile number"
            android:layout_marginTop="7dp"
            android:inputType="phone"
            android:maxLength="10"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= NEXT ================= -->

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:text="NEXT  →"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:backgroundTint="#5B21B6"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>