<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F7F5FC">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Try MySCHOOL Demo" android:textColor="#4527A0" android:textSize="26sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="32dp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a role to explore sample school features. Demo data is stored locally on this device and is separate from real school records." android:textColor="#666666" android:textSize="15sp" android:gravity="center" android:lineSpacingExtra="4dp" android:layout_marginTop="12dp" android:layout_marginBottom="28dp"/>
        <Button android:id="@+id/btnDemoAdmin" android:layout_width="match_parent" android:layout_height="58dp" android:text="Continue as Demo Admin" android:textAllCaps="false" android:textStyle="bold" android:textSize="16sp" android:textColor="#FFFFFF" android:backgroundTint="#6D28D9"/>
        <Button android:id="@+id/btnDemoTeacher" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="16dp" android:text="Continue as Demo Teacher" android:textAllCaps="false" android:textStyle="bold" android:textSize="16sp" android:textColor="#FFFFFF" android:backgroundTint="#0F766E"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="DEMO MODE • No real Firebase records are used by this demo screen." android:textColor="#777777" android:textSize="12sp" android:gravity="center" android:layout_marginTop="28dp"/>
    </LinearLayout>
</ScrollView>