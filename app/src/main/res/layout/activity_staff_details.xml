<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F5FC">

    <!-- TOP BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Staff Details"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:gravity="center"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PROFILE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="18dp"
                android:background="#FFFFFF">

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_camera"
                    android:contentDescription="Staff Photo"/>

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Staff / Teacher"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/tvEmployeeId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Employee ID"
                    android:textSize="14sp"
                    android:textColor="#777777"
                    android:gravity="center"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- PERSONAL INFORMATION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PERSONAL INFORMATION"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvPersonalInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:background="#FFFFFF"/>

                <!-- PROFESSIONAL INFORMATION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROFESSIONAL INFORMATION"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvProfessionalInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:background="#FFFFFF"/>

                <!-- ROLE INFORMATION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ROLE INFORMATION"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvRoleInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:background="#FFFFFF"/>

                <!-- ADDRESS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ADDRESS"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvAddressInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:background="#FFFFFF"/>

                <!-- EMERGENCY CONTACT -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCY CONTACT"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvEmergencyInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:background="#FFFFFF"/>

                <!-- LOGIN INFORMATION -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LOGIN INFORMATION"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvLoginInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:background="#FFFFFF"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>