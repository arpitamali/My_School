<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#7B61FF"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnSchoolTimeBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="School Time Setup"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="School Timing"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Set the school timing once. Timetable periods will be generated automatically."
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="School Start Time"
                android:textColor="#555555"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSchoolStartTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:clickable="true"
                android:focusable="false"
                android:hint="e.g. 8:00 AM" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="School End Time"
                android:textColor="#555555"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSchoolEndTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:clickable="true"
                android:focusable="false"
                android:hint="e.g. 2:30 PM" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="One Period Duration (minutes)"
                android:textColor="#555555"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPeriodMinutes"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp"
                android:hint="e.g. 40"
                android:inputType="number" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Number of Breaks"
                android:textColor="#555555"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerBreakCount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp" />

            <LinearLayout
                android:id="@+id/breakContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Saturday"
                android:textColor="#555555"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerSaturdayMode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="5dp" />

            <EditText
                android:id="@+id/etSaturdayEndTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:clickable="true"
                android:focusable="false"
                android:hint="Saturday half-day end time"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/cbMonthEndHalfDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Month-end is Half Day" />

            <EditText
                android:id="@+id/etMonthEndEndTime"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="false"
                android:hint="Month-end half-day end time" />

            <Button
                android:id="@+id/btnSaveSchoolTime"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#7B61FF"
                android:text="Save School Time"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>