<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:clipToPadding="false"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="30dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Register Your School"
                android:textColor="#4B1FA8"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="45dp"
                android:layout_height="45dp"/>

        </LinearLayout>


        <!-- STEP INDICATOR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/step_active"
                android:gravity="center"
                android:text="1"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="70dp"
                android:layout_height="2dp"
                android:background="#DDDDDD"/>

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="2"
                android:textColor="#777777"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="70dp"
                android:layout_height="2dp"
                android:background="#DDDDDD"/>

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="3"
                android:textColor="#777777"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="School Information"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#17102D"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Please provide basic information about your school"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>


        <!-- SCHOOL NAME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="School Name *"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etSchoolName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:hint="Enter school name"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- UDISE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UDISE Number *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/etUdise"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:hint="Enter UDISE number"
            android:inputType="number"
            android:maxLength="11"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- BRANCH -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="School Branch *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/etBranch"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:hint="Enter school branch / location"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- PRINCIPAL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Principal Name *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/etPrincipal"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:hint="Enter principal name"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ADDRESS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="School Address *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:minLines="3"
            android:maxLines="6"
            android:layout_marginTop="7dp"
            android:hint="Enter complete school address"
            android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- LOGO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="School Logo *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <Button
            android:id="@+id/btnSelectLogo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="7dp"
            android:text="☁  Select Image"
            android:textColor="#5B21B6"
            android:textAllCaps="false"
            android:backgroundTint="#F0E9FF"/>


        <!-- NEXT -->

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:text="NEXT  ›"
            android:textSize="17sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#5B21B6"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>