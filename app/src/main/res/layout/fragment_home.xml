<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F6FF">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">


        <!-- ================================================= -->
        <!-- SCHOOL HEADER -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/schoolHeader"
            android:layout_width="match_parent"
            android:layout_height="125dp"
            app:cardBackgroundColor="#42179B"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">


                <!-- SCHOOL EMOJI -->

                <TextView
                    android:id="@+id/tvSchoolEmoji"
                    android:layout_width="55dp"
                    android:layout_height="55dp"
                    android:gravity="center"
                    android:text="🏫"
                    android:textSize="34sp"
                    android:background="@drawable/circle_white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />


                <!-- SCHOOL NAME -->

                <TextView
                    android:id="@+id/tvSchoolName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="90dp"
                    app:layout_constraintStart_toEndOf="@id/tvSchoolEmoji"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvSchoolEmoji" />


                <!-- SCHOOL ADDRESS -->

                <TextView
                    android:id="@+id/tvSchoolAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Loading address..."
                    android:textColor="#E8DFFF"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="90dp"
                    android:layout_marginTop="3dp"
                    app:layout_constraintStart_toEndOf="@id/tvSchoolEmoji"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSchoolName" />


                <!-- ADMIN NAME -->

                <TextView
                    android:id="@+id/tvAdminName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="👤 Admin"
                    android:textColor="#E8DFFF"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="90dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toEndOf="@id/tvSchoolEmoji"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSchoolAddress" />


                <!-- ADMIN DASHBOARD -->

                <TextView
                    android:id="@+id/tvDashboardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin Dashboard"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    app:layout_constraintStart_toEndOf="@id/tvSchoolEmoji"
                    app:layout_constraintTop_toBottomOf="@id/tvAdminName" />


                <!-- LOGOUT -->

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="75dp"
                    android:layout_height="38dp"
                    android:text="Logout"
                    android:textColor="#42179B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:backgroundTint="@android:color/white"
                    android:layout_marginTop="28dp"
                    android:padding="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- OVERVIEW -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvOverview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Overview"
            android:textColor="#17102D"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/schoolHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================= -->
        <!-- STATISTICS -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/statisticsRow"
            android:layout_width="0dp"
            android:layout_height="125dp"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/tvOverview"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- STUDENTS -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStudents"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2DCF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍🎓"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Students"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvStudentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#24105F"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- STAFF -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTeachers"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2DCF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍🏫"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Staff"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTeacherCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#24105F"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- PRESENT -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAttendance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2DCF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📋"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Present"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvPresentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#24105F"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>


            <!-- BIRTHDAY -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBirthday"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2DCF0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="5dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎂"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Today's"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Birthday"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvBirthdayCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#24105F"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- QUICK ACTIONS -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvQuickActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textColor="#17102D"
            android:textSize="19sp"
            android:textStyle="bold"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="18dp"
            app:layout_constraintTop_toBottomOf="@id/statisticsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <LinearLayout
            android:id="@+id/quickActionsRow1"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvQuickActions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- ADD STUDENT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAddStudent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeColor="#E2DCF0"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="👨‍🎓"
                        android:textSize="23sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Student" android:textColor="#333333" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ADD STAFF -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAddStaff" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="4dp" android:clickable="true" android:focusable="true"
                app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" app:strokeColor="#E2DCF0" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👨‍🏫" android:textSize="23sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add" android:textColor="#333333" android:textSize="11sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Staff" android:textColor="#333333" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TEACHER ATTENDANCE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnTeacherAttendance" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="4dp" android:clickable="true" android:focusable="true"
                app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" app:strokeColor="#E2DCF0" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧑‍🏫" android:textSize="23sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Teacher" android:textColor="#333333" android:textSize="11sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Attendance" android:textColor="#333333" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SCHOOL TIMETABLE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAdminTimetable" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_margin="4dp" android:clickable="true" android:focusable="true"
                app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" app:strokeColor="#E2DCF0" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🗓️" android:textSize="23sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="School" android:textColor="#333333" android:textSize="11sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Timetable" android:textColor="#333333" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickActionsRow2"
            android:layout_width="0dp" android:layout_height="100dp"
            android:orientation="horizontal" android:weightSum="4"
            android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/quickActionsRow1"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">

            <!-- POST NOTICE -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPostNotice" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:clickable="true" android:focusable="true"
                app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" app:strokeColor="#E2DCF0" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📢" android:textSize="23sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Post" android:textColor="#333333" android:textSize="11sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notice" android:textColor="#333333" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SEE ALL NOTICES -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnMessage" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:clickable="true" android:focusable="true"
                app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" app:strokeColor="#E2DCF0" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋" android:textSize="23sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="See All" android:textColor="#333333" android:textSize="11sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notices" android:textColor="#333333" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ACHIEVEMENT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnAchievement" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:clickable="true" android:focusable="true"
                app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" app:strokeColor="#E2DCF0" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏆" android:textSize="23sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="School" android:textColor="#333333" android:textSize="11sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Achievement" android:textColor="#333333" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SALARY / PAYMENT -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSalaryPayment" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="4dp" android:clickable="true" android:focusable="true"
                app:cardCornerRadius="14dp" app:cardElevation="1dp" app:cardBackgroundColor="#FFFFFF" app:strokeColor="#E2DCF0" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💰" android:textSize="23sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Salary /" android:textColor="#333333" android:textSize="11sp" android:textStyle="bold"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Payment" android:textColor="#333333" android:textSize="11sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ================================================= -->
        <!-- RECENT ACTIVITIES -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecentActivities"
            android:layout_width="0dp"
            android:layout_height="245dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E2DCF0"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/quickActionsRow2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


                <!-- HEADER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Recent Activities"
                        android:textColor="#24105F"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:gravity="center_vertical" />

                    <TextView
                        android:id="@+id/btnClearActivities"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="Clear All"
                        android:textColor="#D32F2F"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE" />


                <!-- ACTIVITY 1 -->

                <TextView
                    android:id="@+id/tvActivity1"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:text="No recent activities"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
