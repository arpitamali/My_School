<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginTop="14dp"
                android:text="Student Fees"
                android:textColor="#4B1FA8"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="42dp"
                android:layout_height="42dp"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <Spinner
                android:id="@+id/spClassFilter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_bg"/>

            <View
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <Spinner
                android:id="@+id/spFeeFilter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/edit_text_bg"/>

        </LinearLayout>

        <EditText
            android:id="@+id/etSearchStudent"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/edit_text_bg"
            android:hint="Search student name, roll no..."
            android:textColor="#17102D"
            android:textColorHint="#888888"
            android:textSize="14sp"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:inputType="text"/>

        <TextView
            android:id="@+id/tvStudentCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 Students"
            android:textColor="#777777"
            android:textSize="13sp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="9dp"/>

        <LinearLayout
            android:id="@+id/studentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <TextView
            android:id="@+id/tvNoStudents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="No students found"
            android:textColor="#777777"
            android:textSize="16sp"
            android:padding="40dp"
            android:visibility="gone"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
