<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Students"
                android:textColor="#4B1FA8"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="45dp"
                android:layout_height="45dp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- SUBTITLE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a student to view details"
            android:textColor="#777777"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp" />


        <!-- ================================================= -->
        <!-- COUNT -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvStudentCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 Students"
            android:textColor="#555555"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />


        <!-- ================================================= -->
        <!-- SEARCH BAR -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/etSearchStudent"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/search_box_background"
            android:hint="Search student..."
            android:textColor="#17102D"
            android:textColorHint="#888888"
            android:textSize="15sp"
            android:singleLine="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp" />


        <!-- ================================================= -->
        <!-- STUDENT LIST -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/studentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />


        <!-- ================================================= -->
        <!-- EMPTY -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/tvNoStudents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No students found"
            android:textColor="#777777"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>