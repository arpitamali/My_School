<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:orientation="vertical"
    android:background="#F8F6FF">


    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:paddingStart="7dp"
        android:paddingTop="10dp"
        android:paddingEnd="7dp"
        android:paddingBottom="5dp">


        <!-- TOP BACK -->

        <ImageButton
            android:id="@+id/btnTopBack"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back" />


        <!-- HEADER TITLE -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"

            android:text="Add Staff / Teacher"

            android:textColor="#5726B8"
            android:textSize="17sp"
            android:textStyle="bold" />


        <!-- RIGHT SPACE -->

        <View
            android:layout_width="34dp"
            android:layout_height="34dp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- STEP INDICATOR -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="10dp">


        <!-- STEP 1 -->

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/step_inactive"
            android:gravity="center"
            android:text="1"
            android:textColor="#777777" />


        <View
            android:layout_width="35dp"
            android:layout_height="2dp"
            android:background="#5B21B6" />


        <!-- STEP 2 -->

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/step_inactive"
            android:gravity="center"
            android:text="2"
            android:textColor="#777777"
            android:textStyle="bold" />


        <View
            android:layout_width="35dp"
            android:layout_height="2dp"
            android:background="#5B21B6" />


        <!-- STEP 3 -->

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/step_inactive"
            android:gravity="center"
            android:text="3"
            android:textColor="#777777" />


        <View
            android:layout_width="35dp"
            android:layout_height="2dp"
            android:background="#5B21B6" />


        <!-- STEP 4 -->

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/step_inactive"
            android:gravity="center"
            android:text="4"
            android:textColor="#777777" />


        <View
            android:layout_width="35dp"
            android:layout_height="2dp"
            android:background="#5B21B6" />


        <!-- STEP 5 ACTIVE -->

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/step_active"
            android:gravity="center"
            android:text="5"
            android:textColor="@color/white"
            android:textStyle="bold" />


        <View
            android:layout_width="35dp"
            android:layout_height="2dp"
            android:background="#DDDDDD" />


        <!-- STEP 6 -->

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/step_inactive"
            android:gravity="center"
            android:text="6"
            android:textColor="#777777" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CONTENT -->
    <!-- ===================================================== -->

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"

        android:fillViewport="true"
        android:clipToPadding="false">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="20dp">


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"

                android:text="Login Information"

                android:textColor="#201B26"
                android:textSize="21sp"
                android:textStyle="bold" />


            <!-- SUBTITLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="2dp"

                android:gravity="center"

                android:text="Teacher / staff can login using email or mobile number"

                android:textColor="#77727E"
                android:textSize="12sp" />


            <!-- ================================================= -->
            <!-- EMAIL -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="20dp"

                android:text="Login Email *"

                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/etStaffEmail"

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:layout_marginTop="5dp"

                android:background="@drawable/bg_staff_input"

                android:hint="Enter email address"

                android:paddingStart="12dp"
                android:paddingEnd="12dp"

                android:singleLine="true"

                android:inputType="textEmailAddress"

                android:textColor="#333333"
                android:textColorHint="#999999"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- MOBILE -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:text="Mobile Number *"

                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />


            <EditText
                android:id="@+id/etStaffMobile"

                android:layout_width="match_parent"
                android:layout_height="48dp"

                android:layout_marginTop="5dp"

                android:background="@drawable/bg_staff_input"

                android:hint="10 digit mobile number"

                android:paddingStart="12dp"
                android:paddingEnd="12dp"

                android:singleLine="true"

                android:inputType="phone"
                android:maxLength="10"

                android:textColor="#333333"
                android:textColorHint="#999999"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- PASSWORD -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:text="Password *"

                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password"
                    android:inputType="textPassword"/>

            </com.google.android.material.textfield.TextInputLayout>


            <!-- ================================================= -->
            <!-- CONFIRM PASSWORD -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:text="Confirm Password *"

                android:textColor="#333333"
                android:textSize="13sp"
                android:textStyle="bold" />


            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Confirm Password"
                    android:inputType="textPassword"/>

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </ScrollView>


    <!-- ===================================================== -->
    <!-- BOTTOM BUTTON -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/bottomButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="horizontal"

        android:paddingStart="0dp"
        android:paddingTop="7dp"
        android:paddingEnd="0dp"
        android:paddingBottom="7dp"

        android:background="#F8F6FF">


        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"

            android:text="NEXT  →"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#5B21B6" />

    </LinearLayout>

</LinearLayout>