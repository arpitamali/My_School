<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F6FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@android:drawable/ic_menu_revert"/>


            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginTop="14dp"
                android:text="Transfer / Promote Students"
                android:textColor="#4B1FA8"
                android:textSize="21sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- DESCRIPTION -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            android:text="Select a class and promote the required students to the next academic year."
            android:textColor="#666666"
            android:textSize="14sp"/>


        <!-- ================================================= -->
        <!-- CURRENT CLASS -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E0F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CURRENT CLASS"
                    android:textColor="#4B1FA8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>


                <Spinner
                    android:id="@+id/spCurrentClass"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- STUDENT SECTION -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E0F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">


                <!-- ================================================= -->
                <!-- TITLE ROW -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStudentCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Students: 0"
                        android:textColor="#4B1FA8"
                        android:textSize="15sp"
                        android:textStyle="bold"/>


                    <CheckBox
                        android:id="@+id/cbSelectAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select All"
                        android:textColor="#444444"
                        android:textSize="13sp"/>

                </LinearLayout>


                <!-- ================================================= -->
                <!-- INFO -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:text="Students are shown surname-wise (A-Z)."
                    android:textColor="#777777"
                    android:textSize="12sp"/>


                <!-- ================================================= -->
                <!-- STUDENTS -->
                <!-- ================================================= -->

                <LinearLayout
                    android:id="@+id/studentContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>


                <TextView
                    android:id="@+id/tvNoStudents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Select a class to view students"
                    android:textColor="#777777"
                    android:textSize="14sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- NEW DETAILS -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E0F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NEW ACADEMIC DETAILS"
                    android:textColor="#4B1FA8"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>


                <!-- ================================================= -->
                <!-- ACADEMIC YEAR -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="New Academic Year"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNewAcademicYear"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Example: 2027-28"
                        android:inputType="text"
                        android:singleLine="true"/>

                </com.google.android.material.textfield.TextInputLayout>


                <!-- ================================================= -->
                <!-- NEW CLASS -->
                <!-- ================================================= -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="New Class"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"/>


                <Spinner
                    android:id="@+id/spNewClass"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"/>


                <!-- ================================================= -->
                <!-- NEW DIVISION -->
                <!-- ================================================= -->

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="New Division"
                    app:boxBackgroundMode="outline">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNewDivision"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Example: A"
                        android:inputType="textCapCharacters"
                        android:maxLength="2"
                        android:singleLine="true"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- PROMOTE BUTTON -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnPromote"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#4B1FA8"
            android:text="PROMOTE SELECTED STUDENTS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>


    </LinearLayout>

</androidx.core.widget.NestedScrollView>