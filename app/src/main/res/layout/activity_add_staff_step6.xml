<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="30dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Add Staff / Teacher"
                android:textColor="#4B1FA8"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="45dp"
                android:layout_height="45dp"/>

        </LinearLayout>


        <!-- ================= STEP INDICATOR ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="1"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="2"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="3"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="4"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="5"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_active"
                android:gravity="center"
                android:text="6"
                android:textColor="@android:color/white"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ================= TITLE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Review Staff Information"
            android:textColor="#17102D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Please review all information before submitting"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>


        <!-- ================= PHOTO ================= -->

        <ImageView
            android:id="@+id/ivStaffPhoto"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerCrop"
            android:background="@drawable/edit_text_bg"/>


        <!-- ================= NAME ================= -->

        <TextView
            android:id="@+id/tvStaffName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Staff Name"
            android:textColor="#17102D"
            android:textSize="21sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"/>


        <!-- ================= PERSONAL CARD ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/edit_text_bg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textColor="#4B1FA8"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvPersonalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= PROFESSIONAL CARD ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Professional Information"
                android:textColor="#4B1FA8"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvProfessionalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= ROLE CARD ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Staff Type &amp; Role"
                android:textColor="#4B1FA8"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvRoleInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= ADDRESS CARD ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Address &amp; Emergency"
                android:textColor="#4B1FA8"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAddressInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= LOGIN CARD ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/edit_text_bg"
            android:layout_marginTop="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Login Information"
                android:textColor="#4B1FA8"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvLoginInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="#333333"
                android:textSize="14sp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= CONFIRM ================= -->

        <CheckBox
            android:id="@+id/checkConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I confirm that all staff information entered above is correct."
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginTop="20dp"/>


        <!-- ================= SUBMIT ================= -->

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:text="NEXT  →"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:backgroundTint="#5B21B6"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>