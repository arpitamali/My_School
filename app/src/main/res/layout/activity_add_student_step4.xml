<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Add Student"
                android:textColor="#4B1FA8"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="45dp"
                android:layout_height="45dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Step 4 of 6"
            android:textColor="#5B21B6"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Address &amp; Emergency"
            android:textColor="#17102D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Address *"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="25dp"/>

        <EditText
            android:id="@+id/etCurrentAddress"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="top|start"
            android:hint="Enter current address"
            android:inputType="textMultiLine|textCapSentences"
            android:layout_marginTop="7dp"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permanent Address"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etPermanentAddress"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="top|start"
            android:hint="Enter permanent address"
            android:inputType="textMultiLine|textCapSentences"
            android:layout_marginTop="7dp"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>

        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="City / Village"
            android:layout_marginTop="12dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>

        <EditText
            android:id="@+id/etDistrict"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="District"
            android:layout_marginTop="10dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>

        <EditText
            android:id="@+id/etState"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Maharashtra"
            android:layout_marginTop="10dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>

        <EditText
            android:id="@+id/etPinCode"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="PIN Code"
            android:inputType="number"
            android:maxLength="6"
            android:layout_marginTop="10dp"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emergency Contact"
            android:textColor="#4B1FA8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"/>

        <EditText
            android:id="@+id/etEmergencyName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Emergency contact name"
            android:layout_marginTop="10dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>

        <EditText
            android:id="@+id/etEmergencyRelation"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Relationship"
            android:layout_marginTop="10dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>

        <EditText
            android:id="@+id/etEmergencyMobile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Emergency mobile number"
            android:inputType="phone"
            android:maxLength="10"
            android:layout_marginTop="10dp"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="NEXT  ›"
            android:textSize="17sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#5B21B6"
            android:layout_marginTop="25dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>