<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F8F6FF">


    <!-- ===================================================== -->
    <!-- BACK BUTTON -->
    <!-- ===================================================== -->

    <ImageButton
        android:id="@+id/btnBack"

        android:layout_width="48dp"
        android:layout_height="48dp"

        android:layout_marginStart="6dp"
        android:layout_marginTop="24dp"

        android:background="@android:color/transparent"

        android:src="@android:drawable/ic_menu_revert"

        android:contentDescription="Back"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ===================================================== -->
    <!-- TITLE -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvTitle"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:text="Staff Attendance"

        android:textColor="#17102D"
        android:textSize="22sp"
        android:textStyle="bold"

        android:gravity="center"

        android:layout_marginTop="24dp"

        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack" />


    <!-- ===================================================== -->
    <!-- DATE LABEL -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvDateLabel"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="14dp"
        android:layout_marginTop="16dp"

        android:text="Attendance Date"

        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack" />


    <!-- ===================================================== -->
    <!-- DATE -->
    <!-- ===================================================== -->

    <EditText
        android:id="@+id/etAttendanceDate"

        android:layout_width="0dp"
        android:layout_height="50dp"

        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="6dp"

        android:background="@drawable/bg_staff_input"

        android:hint="Select date"

        android:focusable="false"
        android:clickable="true"

        android:paddingStart="12dp"
        android:paddingEnd="12dp"

        android:textColor="#333333"
        android:textColorHint="#999999"
        android:textSize="14sp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toBottomOf="@id/tvDateLabel" />


    <!-- ===================================================== -->
    <!-- SUMMARY -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/layoutSummary"

        android:layout_width="0dp"
        android:layout_height="70dp"

        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"

        android:orientation="horizontal"

        android:weightSum="4"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toBottomOf="@id/etAttendanceDate">


        <!-- PRESENT -->

        <com.google.android.material.card.MaterialCardView

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:layout_marginEnd="3dp"

            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"

            app:strokeColor="#E5E0F0"
            app:strokeWidth="1dp">


            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvPresentCount"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="0"

                    android:textColor="#2E7D32"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Present"

                    android:textColor="#777777"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ABSENT -->

        <com.google.android.material.card.MaterialCardView

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"

            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"

            app:strokeColor="#E5E0F0"
            app:strokeWidth="1dp">


            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvAbsentCount"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="0"

                    android:textColor="#D32F2F"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Absent"

                    android:textColor="#777777"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- HALF DAY -->

        <com.google.android.material.card.MaterialCardView

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"

            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"

            app:strokeColor="#E5E0F0"
            app:strokeWidth="1dp">


            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvHalfDayCount"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="0"

                    android:textColor="#F57C00"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Half Day"

                    android:textColor="#777777"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- HOLIDAY -->

        <com.google.android.material.card.MaterialCardView

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_weight="1"

            android:layout_marginStart="3dp"

            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"

            app:strokeColor="#E5E0F0"
            app:strokeWidth="1dp">


            <LinearLayout

                android:layout_width="match_parent"
                android:layout_height="match_parent"

                android:gravity="center"
                android:orientation="vertical">


                <TextView
                    android:id="@+id/tvHolidayCount"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="0"

                    android:textColor="#7B1FA2"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:text="Holiday"

                    android:textColor="#777777"
                    android:textSize="11sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- STAFF LIST -->
    <!-- ===================================================== -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAttendance"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"

        android:clipToPadding="false"

        android:paddingBottom="8dp"

        app:layout_constraintTop_toBottomOf="@id/layoutSummary"
        app:layout_constraintBottom_toTopOf="@id/btnMarkHoliday"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- MARK HOLIDAY -->
    <!-- ===================================================== -->

    <Button
        android:id="@+id/btnMarkHoliday"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"

        android:text="MARK AS HOLIDAY"

        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"

        android:textAllCaps="false"

        android:backgroundTint="#7B1FA2"

        app:layout_constraintBottom_toTopOf="@id/btnSaveAttendance"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ===================================================== -->
    <!-- SAVE BUTTON -->
    <!-- ===================================================== -->

    <Button
        android:id="@+id/btnSaveAttendance"

        android:layout_width="0dp"
        android:layout_height="58dp"

        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"

        android:text="SAVE ATTENDANCE"

        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"

        android:textAllCaps="false"

        android:backgroundTint="#5B21B6"

        app:layout_constraintBottom_toBottomOf="parent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>