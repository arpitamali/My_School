<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add Timetable Period"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <!-- CLASS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Class"
            android:textColor="#555555"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/spinnerTimetableClass"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/editbox_background" />

        <!-- DIVISION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Division"
            android:textColor="#555555"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/spinnerTimetableDivision"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/editbox_background" />

        <!-- SUBJECT -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Subject"
            android:textColor="#555555"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/spinnerTimetableSubject"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@android:drawable/editbox_background" />

        <!-- START TIME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Time"
            android:textColor="#555555"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/etTimetableStartTime"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select start time"
            android:inputType="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- END TIME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="End Time"
            android:textColor="#555555"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="5dp" />

        <EditText
            android:id="@+id/etTimetableEndTime"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select end time"
            android:inputType="none"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- RECESS -->

        <Switch
            android:id="@+id/switchTimetableRecess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="This is Recess"
            android:textColor="#333333"
            android:textSize="14sp" />

        <!-- SAVE -->

        <Button
            android:id="@+id/btnSaveTimetablePeriod"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="15dp"
            android:backgroundTint="#7B61FF"
            android:text="Save Period"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>