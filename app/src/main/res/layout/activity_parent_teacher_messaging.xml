<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FB">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="#7B61FF">
        <ImageButton
            android:id="@+id/btnParentTeacherMessagingBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:tint="@android:color/white"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginTop="16dp"
            android:text="Teacher Messaging"
            android:textColor="@android:color/white"
            android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/parentTeacherProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>
    <TextView
        android:id="@+id/tvParentTeacherStudentInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:text="Student"
        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold"/>
    <Spinner
        android:id="@+id/spinnerParentTeacher"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF">
        <EditText
            android:id="@+id/etParentTeacherMessage"
            android:layout_width="0dp"

            android:layout_height="54dp"
            android:layout_weight="1"
            android:hint="Write a message to teacher..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:padding="12dp"/>
        <Button
            android:id="@+id/btnSendParentTeacherMessage" android:layout_width="wrap_content" android:layout_height="54dp" android:layout_marginStart="8dp" android:text="Send" android:textAllCaps="false"/>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="14dp" android:paddingTop="12dp" android:paddingBottom="6dp" android:text="My Messages" android:textColor="#222222" android:textSize="14sp" android:textStyle="bold"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp">
        <TextView android:id="@+id/tvParentTeacherMessages" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFF" android:padding="14dp" android:text="No messages sent yet." android:textColor="#555555" android:textSize="13sp"/>
    </ScrollView>
</LinearLayout>