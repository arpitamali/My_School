<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="30dp">


        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingTop="5dp"
            android:paddingBottom="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Register Your School"
                android:textColor="#4B1FA8"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="45dp"
                android:layout_height="45dp"/>

        </LinearLayout>


        <!-- STEP INDICATOR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/step_completed"
                android:gravity="center"
                android:text="✓"
                android:textColor="#5B21B6"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="70dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/step_completed"
                android:gravity="center"
                android:text="✓"
                android:textColor="#5B21B6"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="70dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/step_active"
                android:gravity="center"
                android:text="3"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Review &amp; Submit"
            android:textColor="#17102D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Please review your details before submitting"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>


        <!-- SCHOOL HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F0E9FF"
            android:padding="13dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="🏫"
                android:textSize="20sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="School Information"
                android:textColor="#4B1FA8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>

        </LinearLayout>


        <!-- SCHOOL INFORMATION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_box"
            android:padding="15dp">

            <ImageView
                android:id="@+id/ivSchoolLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:contentDescription="School Logo"/>

            <TextView
                android:id="@+id/tvSchoolInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#222222"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ADMIN HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F0E9FF"
            android:padding="13dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="20sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Information"
                android:textColor="#4B1FA8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>

        </LinearLayout>


        <!-- ADMIN INFORMATION -->

        <TextView
            android:id="@+id/tvAdminInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_box"
            android:padding="15dp"
            android:textColor="#222222"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"/>


        <!-- CONFIRM -->

        <CheckBox
            android:id="@+id/checkConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I confirm that all the above information is correct."
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginTop="18dp"/>


        <!-- TERMS -->

        <CheckBox
            android:id="@+id/checkTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I agree to the Terms &amp; Conditions and Privacy Policy."
            android:textColor="#333333"
            android:textSize="14sp"/>


        <!-- REGISTER -->

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#5B21B6"
            android:text="REGISTER SCHOOL  ✓"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="15dp"
            android:text="🔒 Your information is secure with us."
            android:textColor="#777777"
            android:textSize="12sp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>