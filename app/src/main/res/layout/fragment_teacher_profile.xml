<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="25dp">

        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:text="Profile"
            android:textColor="#5427D6"
            android:textSize="21sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <!-- PROFILE ICON -->

        <TextView
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="♙"
            android:textSize="45sp"
            android:textColor="#777777"
            android:background="@drawable/profile_circle"/>

        <!-- NAME -->

        <TextView
            android:id="@+id/tvProfileTeacherName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Teacher Name"
            android:textColor="#202020"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <!-- SUBJECT -->

        <TextView
            android:id="@+id/tvProfileTeacherSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="Subject Teacher"
            android:textColor="#777777"
            android:textSize="12sp"/>

        <!-- PERSONAL INFORMATION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/profile_box">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textColor="#27212F"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <!-- EMAIL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#777777"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Not Available"
                    android:textColor="#333333"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- MOBILE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mobile"
                    android:textColor="#777777"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvProfileMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Not Available"
                    android:textColor="#333333"
                    android:textSize="13sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- MY TIMETABLE -->

        <LinearLayout
            android:id="@+id/rowMyTimetable"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:background="@drawable/profile_menu_box"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="My Timetable"
                android:textColor="#333333"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#555555"
                android:textSize="20sp"/>

        </LinearLayout>

        <!-- HELP -->

        <LinearLayout
            android:id="@+id/rowHelpSupport"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:background="@drawable/profile_menu_box"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Help &amp; Support"
                android:textColor="#333333"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#555555"
                android:textSize="20sp"/>

        </LinearLayout>

        <!-- ABOUT SCHOOL -->

        <LinearLayout
            android:id="@+id/rowAboutSchool"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:background="@drawable/profile_menu_box"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="About MySchool"
                android:textColor="#333333"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="›"
                android:textColor="#555555"
                android:textSize="20sp"/>

        </LinearLayout>

        <!-- LOGOUT -->

        <TextView
            android:id="@+id/btnTeacherLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Logout"
            android:textColor="#D32F2F"
            android:textSize="13sp"
            android:background="@drawable/logout_box"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</ScrollView>