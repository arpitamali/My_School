<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="30dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Add Staff / Teacher"
                android:textColor="#4B1FA8"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="45dp"
                android:layout_height="45dp"/>

        </LinearLayout>


        <!-- ================= STEP INDICATOR ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="1"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_active"
                android:gravity="center"
                android:text="2"
                android:textColor="@android:color/white"
                android:textStyle="bold"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#DDDDDD"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="3"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#DDDDDD"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="4"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#DDDDDD"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="5"
                android:textColor="#777777"/>

            <View
                android:layout_width="35dp"
                android:layout_height="2dp"
                android:background="#DDDDDD"/>

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="6"
                android:textColor="#777777"/>

        </LinearLayout>


        <!-- ================= TITLE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Professional Information"
            android:textColor="#17102D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Enter professional details"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>


        <!-- ================= EMPLOYEE ID ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Employee ID *"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etEmployeeId"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter employee ID"
            android:layout_marginTop="7dp"
            android:inputType="textCapCharacters"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= JOINING DATE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Joining Date *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etJoiningDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Select joining date"
            android:layout_marginTop="7dp"
            android:focusable="false"
            android:clickable="true"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= QUALIFICATION ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Qualification *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etQualification"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter qualification"
            android:layout_marginTop="7dp"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= EXPERIENCE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Experience"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <EditText
            android:id="@+id/etExperience"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Example: 5 years"
            android:layout_marginTop="7dp"
            android:inputType="text"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- ================= EMPLOYMENT TYPE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Employment Type *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="18dp"/>

        <Spinner
            android:id="@+id/spEmploymentType"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/edit_text_bg"/>


        <!-- ================= NEXT BUTTON ================= -->

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="28dp"
            android:text="NEXT  →"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:backgroundTint="#5B21B6"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>