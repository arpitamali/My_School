<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="35dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Add Student"
                android:textColor="#4B1FA8"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="45dp"
                android:layout_height="45dp"/>

        </LinearLayout>


        <!-- ================= STEP ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Step 6 of 7"
            android:textColor="#5B21B6"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>


        <!-- ================= TITLE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Student Login Details"
            android:textColor="#17102D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Create login credentials for the student"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp"/>


        <!-- ================= EMAIL ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Email *"
            android:textColor="#333333"
            android:textStyle="bold"/>


        <EditText
            android:id="@+id/etStudentEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/edit_text_bg"
            android:hint="Enter student email"
            android:inputType="textEmailAddress"
            android:padding="15dp"/>


        <!-- ================= PHONE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Phone *"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="18dp"/>


        <EditText
            android:id="@+id/etStudentPhone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/edit_text_bg"
            android:hint="Enter 10 digit phone number"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="15dp"/>


        <!-- ================= PASSWORD ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password *"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="18dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/edit_text_bg">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Enter password"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="5dp"/>


            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginEnd="5dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="Show or hide password"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>


        <!-- ================= CONFIRM PASSWORD ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm Password *"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginTop="18dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/edit_text_bg">

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Re-enter password"
                android:inputType="textPassword"
                android:paddingStart="15dp"
                android:paddingEnd="5dp"/>


            <ImageView
                android:id="@+id/ivToggleConfirmPassword"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_marginEnd="5dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_view"
                android:contentDescription="Show or hide confirm password"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>


        <!-- ================= INFO BOX ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_box"
            android:padding="15dp"
            android:layout_marginTop="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 Login Information"
                android:textColor="#4B1FA8"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="The student will use this email and password to login to the student portal."
                android:textColor="#666666"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="8dp"/>

        </LinearLayout>


        <!-- ================= NEXT ================= -->

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="25dp"
            android:text="NEXT  ›"
            android:textColor="@android:color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#5B21B6"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>