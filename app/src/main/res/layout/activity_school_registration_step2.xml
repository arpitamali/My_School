<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="30dp">


        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Register Your School"
                android:textColor="#4B1FA8"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="45dp"
                android:layout_height="45dp"/>

        </LinearLayout>


        <!-- STEP INDICATOR -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="5dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/step_completed"
                android:gravity="center"
                android:text="✓"
                android:textColor="#5B21B6"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="70dp"
                android:layout_height="2dp"
                android:background="#5B21B6"/>

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/step_active"
                android:gravity="center"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="70dp"
                android:layout_height="2dp"
                android:background="#DDDDDD"/>

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/step_inactive"
                android:gravity="center"
                android:text="3"
                android:textColor="#777777"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Admin Information"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#17102D"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Create administrator account for your school"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>


        <!-- ADMIN NAME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Full Name *"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etAdminName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:hint="Enter admin full name"
            android:inputType="textCapWords"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- EMAIL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email Address *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:hint="Enter email address"
            android:inputType="textEmailAddress"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- MOBILE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile Number *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/etMobile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:hint="Enter mobile number"
            android:inputType="phone"
            android:maxLength="10"
            android:background="@drawable/edit_text_bg"
            android:padding="15dp"/>


        <!-- PASSWORD -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="15dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/edit_text_bg">

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Create password"
                android:inputType="textPassword"
                android:background="@android:color/transparent"
                android:paddingStart="15dp"
                android:paddingEnd="8dp"/>

            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:padding="12dp"
                android:src="@drawable/ic_eye_off"
                android:contentDescription="Show password"/>

        </LinearLayout>


        <!-- CONFIRM PASSWORD -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm Password *"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginTop="15dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/edit_text_bg">

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Confirm password"
                android:inputType="textPassword"
                android:background="@android:color/transparent"
                android:paddingStart="15dp"
                android:paddingEnd="8dp"/>

            <ImageView
                android:id="@+id/ivToggleConfirmPassword"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:padding="12dp"
                android:src="@drawable/ic_eye_off"
                android:contentDescription="Show password"/>

        </LinearLayout>


        <!-- NEXT -->

        <Button
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="22dp"
            android:text="NEXT  ›"
            android:textSize="17sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#5B21B6"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>