<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- TOP -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAllAttendanceStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Rahul Patil"
                    android:textColor="#25252B"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAllAttendanceClassDivision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Class 8 - A"
                    android:textColor="#6B6F7B"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAllAttendanceRollNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Roll No: 12"
                    android:textColor="#888888"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- PERCENTAGE -->

            <TextView
                android:id="@+id/tvAllAttendancePercentage"
                android:layout_width="72dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="85%"
                android:textColor="#5427D8"
                android:textSize="19sp"
                android:textStyle="bold"
                android:background="#F0EBFF" />

        </LinearLayout>


        <!-- DIVIDER -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="#EEEEEE" />


        <!-- SUMMARY -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAllAttendancePresent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Present  17"
                android:textColor="#168A45"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAllAttendanceAbsent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Absent  3"
                android:textColor="#D13B3B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAllAttendanceHoliday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Holiday  2"
                android:textColor="#777777"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="end"
            android:text="Tap to view full history  ›"
            android:textColor="#5427D8"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>