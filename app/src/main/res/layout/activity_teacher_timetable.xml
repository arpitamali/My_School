<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FB">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="16dp"
        android:background="#7B61FF">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnTimetableBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@android:color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Timetable"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill class timetable"
                android:textColor="#E9E4FF"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- SCHOOL TIME SETUP -->
            <Button
                android:id="@+id/btnSchoolTimeSetup"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#7B61FF"
                android:text="⚙  School Time Setup"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- INFO -->
            <TextView
                android:id="@+id/tvTimetableScheduleInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:background="#EDEAFF"
                android:text="Configure School Time Setup first."
                android:textColor="#4B3AA8"
                android:textSize="13sp" />

            <!-- TITLE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Fill Timetable"
                android:textColor="#222222"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- CLASS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Select Class"
                android:textColor="#555555"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerFillTimetableClass"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp" />

            <!-- DIVISION -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Select Division"
                android:textColor="#555555"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerFillTimetableDivision"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp" />

            <!-- DAY -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Select Day"
                android:textColor="#555555"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerFillTimetableDay"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp" />

            <!-- LOADING -->
            <ProgressBar
                android:id="@+id/timetableProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- NO PERIOD MESSAGE -->
            <TextView
                android:id="@+id/tvNoPeriods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:padding="14dp"
                android:text="Select Class, Division and Day"
                android:textColor="#777777"
                android:textSize="14sp" />

            <!-- TIMETABLE -->
            <LinearLayout
                android:id="@+id/timetableEntryContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- SAVE -->
            <Button
                android:id="@+id/btnSaveTimetable"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="25dp"
                android:backgroundTint="#7B61FF"
                android:enabled="false"
                android:text="Save Timetable"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>