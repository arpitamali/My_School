<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="#F8F6FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="35dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingVertical="10dp">

            <ImageButton
                android:id="@+id/btnBackStep7"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Add Student"
                android:textColor="#4B1FA8"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <Space
                android:layout_width="45dp"
                android:layout_height="45dp"/>

        </LinearLayout>


        <!-- ================= STEP ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Step 7 of 7"
            android:textColor="#5B21B6"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>


        <!-- ================= TITLE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Review &amp; Submit"
            android:textColor="#17102D"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Please review all student information before submitting"
            android:textColor="#777777"
            android:textSize="14sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>


        <!-- ================= STUDENT INFORMATION ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_box"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Student Information"
                android:textColor="#4B1FA8"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/ivStudentPhoto"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="Student Photo"/>

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="#17102D"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/tvPersonalInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#444444"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= ACADEMIC ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_box"
            android:padding="16dp"
            android:layout_marginTop="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Academic Information"
                android:textColor="#4B1FA8"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAcademicInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#444444"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= PARENT / GUARDIAN ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_box"
            android:padding="16dp"
            android:layout_marginTop="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Parent / Guardian Information"
                android:textColor="#4B1FA8"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvParentInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#444444"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= ADDRESS ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_box"
            android:padding="16dp"
            android:layout_marginTop="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Address &amp; Emergency"
                android:textColor="#4B1FA8"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAddressInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#444444"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= FEES ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_box"
            android:padding="16dp"
            android:layout_marginTop="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Fees Details"
                android:textColor="#4B1FA8"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvFeesInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#444444"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= LOGIN ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/white_box"
            android:padding="16dp"
            android:layout_marginTop="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Login Details"
                android:textColor="#4B1FA8"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvLoginInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#444444"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="10dp"/>

        </LinearLayout>


        <!-- ================= CONFIRMATION ================= -->

        <CheckBox
            android:id="@+id/checkConfirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I confirm that all the above information is correct."
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginTop="20dp"/>


        <!-- ================= SUBMIT ================= -->

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="15dp"
            android:text="✓  ADD STUDENT"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="#5B21B6"/>


        <!-- ================= SUCCESS ================= -->

        <TextView
            android:id="@+id/tvSubmitted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="✓ Student Added Successfully"
            android:textColor="#2E7D32"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:padding="20dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>