<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F7FB">

    <!-- TOP BAR -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:background="#7B61FF">

        <ImageButton
            android:id="@+id/btnParentMessagesBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:text="Parent Messages"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- LOADING -->

    <ProgressBar
        android:id="@+id/parentMessagesProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <!-- EMPTY MESSAGE -->

    <TextView
        android:id="@+id/tvParentMessagesEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="25dp"
        android:text="No parent messages yet"
        android:textColor="#777777"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- MESSAGES -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerParentMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false" />

    <!-- REPLY AREA -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@android:color/white">

        <EditText
            android:id="@+id/etParentMessageReply"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@android:drawable/editbox_background"
            android:hint="Write reply..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSendParentReply"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#7B61FF"
            android:src="@android:drawable/ic_menu_send"
            android:contentDescription="Send Reply"
            android:tint="@android:color/white" />

    </LinearLayout>

</LinearLayout>